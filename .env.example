# Copy to .env (never commit .env). Values below are placeholders.

# ---- Docker Compose / PostgreSQL
POSTGRES_USER=missionsprint
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=missionsprint
FRONTEND_PORT=8080
BACKEND_PORT=5000
# Load labelled [DEMO] data on first start: true | false
SEED_DEMO_DATA=false

# ---- Monitoring profile (docker compose --profile monitoring up -d)
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ---- Running the backend directly (without Docker)
DATABASE_URL=postgresql+psycopg2://missionsprint:CHANGE_ME@localhost:5432/missionsprint
CORS_ORIGINS=http://localhost:5173
# Optional: JSON status endpoint of a CI/CD provider. Leave empty for "not connected".
CICD_STATUS_URL=

# ---- Backend tests on PostgreSQL (optional; database name must end in _test)
# TEST_DATABASE_URL=postgresql+psycopg2://missionsprint:CHANGE_ME@localhost:5432/missionsprint_test

# Frontend dev server (frontend/.env): VITE_API_BASE_URL=http://localhost:5000/api
